<?xml version="1.0"?>

<sdf version="1.10">

  <world name="lidar_avoidance_advanced_world">

    <!-- ================================================== -->
    <!-- SYSTEMS                                            -->
    <!-- ================================================== -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>
        ogre2
      </render_engine>

    </plugin>


    <!-- ================================================== -->
    <!-- PHYSICS                                            -->
    <!-- ================================================== -->

    <physics
      name="physics"
      type="ignored">

      <max_step_size>
        0.001
      </max_step_size>

      <real_time_factor>
        1.0
      </real_time_factor>

    </physics>

    <gravity>
      0 0 -9.81
    </gravity>


    <!-- ================================================== -->
    <!-- SCENE                                              -->
    <!-- ================================================== -->

    <scene>

      <ambient>
        0.4 0.4 0.4 1
      </ambient>

      <background>
        0.7 0.8 1.0 1
      </background>

      <shadows>
        true
      </shadows>

    </scene>


    <light
      type="directional"
      name="sun">

      <cast_shadows>
        true
      </cast_shadows>

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        0.9 0.9 0.9 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>

    </light>


    <!-- ================================================== -->
    <!-- GROUND                                             -->
    <!-- ================================================== -->

    <model name="ground">

      <static>
        true
      </static>

      <pose>
        30 0 -0.1 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                100 30 0.2
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                100 30 0.2
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.30 0.30 0.30 1
            </ambient>

            <diffuse>
              0.38 0.38 0.38 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- CENTER LINE                                        -->
    <!-- ================================================== -->

    <model name="center_lane">

      <static>
        true
      </static>

      <pose>
        30 0 0.015 0 0 0
      </pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>
                75 0.12 0.02
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.9 0.9 0.9 1
            </ambient>

            <diffuse>
              0.9 0.9 0.9 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- VEHICLE                                            -->
    <!-- ================================================== -->

    <include>

      <uri>
        model://aeb_vehicle
      </uri>

      <name>
        aeb_vehicle
      </name>

      <pose>
        0 0 0 0 0 0
      </pose>

    </include>


    <!-- ================================================== -->
    <!-- SMALL OBSTACLE                                     -->
    <!-- ================================================== -->

    <model name="small_obstacle">

      <static>
        true
      </static>

      <pose>
        -15 8 0.6 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                1.2 1.2 1.2
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                1.2 1.2 1.2
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.85 0.15 0.10 1
            </ambient>

            <diffuse>
              0.85 0.15 0.10 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- LARGE OBSTACLE                                     -->
    <!-- ================================================== -->

    <model name="large_obstacle">

      <static>
        true
      </static>

      <pose>
        -15 5 0.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                3.0 3.0 1.5
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                3.0 3.0 1.5
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.70 0.10 0.10 1
            </ambient>

            <diffuse>
              0.70 0.10 0.10 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STANDARD OBSTACLE 1                                -->
    <!-- ================================================== -->

    <model name="obstacle_one">

      <static>
        true
      </static>

      <pose>
        -15 2 0.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                2.0 2.0 1.5
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                2.0 2.0 1.5
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.90 0.20 0.10 1
            </ambient>

            <diffuse>
              0.90 0.20 0.10 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- STANDARD OBSTACLE 2                                -->
    <!-- ================================================== -->

    <model name="obstacle_two">

      <static>
        true
      </static>

      <pose>
        -15 -2 0.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                2.0 2.0 1.5
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                2.0 2.0 1.5
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.90 0.20 0.10 1
            </ambient>

            <diffuse>
              0.90 0.20 0.10 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- LEFT BLOCKER                                       -->
    <!-- ================================================== -->

    <model name="left_blocker">

      <static>
        true
      </static>

      <pose>
        -15 -5 0.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                2.0 1.8 1.5
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                2.0 1.8 1.5
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.95 0.70 0.05 1
            </ambient>

            <diffuse>
              0.95 0.70 0.05 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- RIGHT BLOCKER                                      -->
    <!-- ================================================== -->

    <model name="right_blocker">

      <static>
        true
      </static>

      <pose>
        -15 -8 0.75 0 0 0
      </pose>

      <link name="link">

        <collision name="collision">

          <geometry>
            <box>
              <size>
                2.0 1.8 1.5
              </size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>
                2.0 1.8 1.5
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.95 0.70 0.05 1
            </ambient>

            <diffuse>
              0.95 0.70 0.05 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================== -->
    <!-- FAR GOAL MARKER                                    -->
    <!-- ================================================== -->

    <model name="far_goal">

      <static>
        true
      </static>

      <pose>
        58 0 0.02 0 0 0
      </pose>

      <link name="link">

        <visual name="visual">

          <geometry>
            <box>
              <size>
                5 5 0.03
              </size>
            </box>
          </geometry>

          <material>

            <ambient>
              0.1 0.8 0.1 1
            </ambient>

            <diffuse>
              0.1 0.8 0.1 1
            </diffuse>

          </material>

        </visual>

      </link>

    </model>

  </world>

</sdf>
