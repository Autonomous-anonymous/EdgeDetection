<?xml version="1.0"?>
<sdf version="1.10">

  <world name="lidar_360_avoidance_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>35 0 -0.1 0 0 0</pose>

      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>100 26 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>100 26 0.2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.30 0.30 0.30 1</ambient>
            <diffuse>0.38 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_lane">
      <static>true</static>
      <pose>35 0 0.015 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>76 0.12 0.02</size>
            </box>
          </geometry>

          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://aeb_vehicle_360</uri>
      <name>aeb_vehicle_360</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="front_obstacle_1">
      <static>true</static>
      <pose>16 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 2.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 2.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.12 0.08 1</ambient>
            <diffuse>0.85 0.12 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rear_left_blocker">
      <static>true</static>
      <pose>2.0 5.0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.65 0.05 1</ambient>
            <diffuse>0.95 0.65 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_obstacle_2">
      <static>true</static>
      <pose>44 0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 2.0 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 2.0 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.75 0.08 0.15 1</ambient>
            <diffuse>0.75 0.08 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rear_right_blocker">
      <static>true</static>
      <pose>30.5 -5.0 0.75 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 1.5</size>
            </box>
          </geometry>

          <material>
            <ambient>0.95 0.65 0.05 1</ambient>
            <diffuse>0.95 0.65 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="goal_zone">
      <static>true</static>
      <pose>64 0 0.02 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>5 5 0.03</size>
            </box>
          </geometry>

          <material>
            <ambient>0.1 0.8 0.1 1</ambient>
            <diffuse>0.1 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>
