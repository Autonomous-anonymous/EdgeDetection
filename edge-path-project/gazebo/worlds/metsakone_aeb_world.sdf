<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Experimental forestry-machine AEB scene. Keep previous SIL/HIL worlds
       unchanged. The forestry machine Z placement needs Gazebo confirmation. -->
  <world name="metsakone_aeb_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <include>
      <uri>model://ruskotunturi_map</uri>
      <name>ruskotunturi_map</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://metsakone</uri>
      <name>metsakone</name>
      <pose>-8 36 -9.16 0 0 -0.6435011088</pose>
    </include>
    <model name="metsakone_test_obstacle">
      <static>true</static>
      <pose>-3 32.25 -9 0 0 0</pose>
      <link name="body">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 6.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 6.0</size></box></geometry>
          <material>
            <ambient>0.95 0.08 0.04 1</ambient>
            <diffuse>0.95 0.08 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
