<?xml version="1.0"?>
<sdf version="1.10">

  <!--
    Ruskotunturi autonomous mission - Phase 3

    Baseline:
      - same lower-area start
      - same upper-area goal
      - same terrain-aware waypoint route

    Phase 3 moving-obstacle test:
      - no artificial static obstacles
      - static-obstacle behaviour was already validated in Phase 2
      - moving scenarios are spatially separated to avoid overlap
      - no visual waypoint marker spheres

    Phase 3 moving obstacles:
      - moving_crossing_obstacle crosses the route laterally
      - moving_slow_obstacle travels slowly in the route direction
      - both follow deterministic scripted poses commanded by the
        mission test harness through Gazebo UserCommands
  -->

  <world name="ruskotunturi_phase4_straight_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ruskotunturi_map</uri>
      <name>ruskotunturi_map</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://aeb_vehicle_360</uri>
      <name>aeb_vehicle_360</name>
      <pose>
        6.000
        33.000
        -9.767282
        0 0 -2.5161076134
      </pose>
    </include>


    <!--
      MOVING OBSTACLE 1: route crossing.

      The route near this area runs through approximately (-18, 10).
      The obstacle begins west of the route and moves east across it.

      The lower part of the map is nearly flat here, so gravity is
      not used for motion; the model follows a deterministic scripted
      trajectory controlled through set_pose_vector.
    -->
<!--
      MOVING OBSTACLE 1: scripted route crossing.

      This model is static from the physics engine's point of view.
      The Python test harness updates its world pose deterministically
      through the Gazebo UserCommands set_pose_vector service.

      This avoids terrain-contact rotation / spinning while preserving
      visual and collision geometry for the ego vehicle's 360 LiDAR.
    -->




    <!--
      MOVING OBSTACLE 2: slow vehicle / object.

      It starts ahead of the ego vehicle on the lower, relatively flat
      route segment around (6, 33) and moves slowly in the same
      direction. The ego vehicle
      should eventually treat it as a persistent obstacle and overtake
      it using the normal 360-degree local planner.
    -->
<!--
      MOVING OBSTACLE 2: scripted slow same-direction object.

      The Python test harness moves this model continuously along a
      terrain-following polyline. The ego controller is NOT given the
      scripted trajectory; it still reacts using 360 LiDAR only.
    -->




    <!--
      PHASE 4: scripted oncoming vehicle.

      The model is static for the physics engine and is moved by the
      Python test harness through UserCommands set_pose_vector.

      The ego controller does NOT use this scripted pose for control.
      The actor starts on the proven-wide early mission corridor at (4,32),
      about 17 m from the ego start. This gives TTC enough lead distance
      while retaining the wide shoulder space already validated by the
      earlier moving-obstacle tests.
      The encounter is detected and evaluated from 360 LiDAR history.
    -->
    <model name="oncoming_vehicle">
      <static>true</static>

      <!-- terrain z at (0, 32) ~= -10.202729 m -->
      <pose>-12.000000 20.000000 -9.153407 0 0 0.6254850402</pose>

      <link name="body">

        <collision name="collision">
          <geometry>
            <box>
              <size>2.200 1.200 1.400</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.200 1.200 1.400</size>
            </box>
          </geometry>

          <material>
            <ambient>0.85 0.25 0.10 1</ambient>
            <diffuse>0.85 0.25 0.10 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>

      </link>
    </model>


  </world>

</sdf>
