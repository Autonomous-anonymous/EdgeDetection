<?xml version="1.0"?>

<sdf version="1.10">

  <model name="aeb_vehicle_360">

    <self_collide>false</self_collide>


    <!-- ================================================== -->
    <!-- CHASSIS                                            -->
    <!-- ================================================== -->

    <link name="chassis">

      <pose>
        0 0 0.55 0 0 0
      </pose>

      <inertial>

        <mass>80.0</mass>

        <inertia>
          <ixx>15.0</ixx>
          <iyy>35.0</iyy>
          <izz>40.0</izz>
        </inertia>

      </inertial>


      <collision name="chassis_collision">

        <geometry>
          <box>
            <size>2.6 1.2 0.35</size>
          </box>
        </geometry>

      </collision>


      <visual name="chassis_visual">

        <geometry>
          <box>
            <size>2.6 1.2 0.35</size>
          </box>
        </geometry>

        <material>
          <ambient>0.05 0.20 0.80 1</ambient>
          <diffuse>0.05 0.20 0.80 1</diffuse>
        </material>

      </visual>


      <!-- ================================================== -->
      <!-- GPU LIDAR                                          -->
      <!-- ================================================== -->

      <!--
        LiDAR on auton etuosassa.

        Horizontal field of view:
        -90 ... +90 degrees

        361 rays
        10 Hz
        0.10 ... 30 m
      -->

      <sensor name="gpu_lidar_360" type="gpu_lidar">
      <!-- Roof-centred 360-degree LiDAR. -->
      <pose>0 0 0.85 0 0 0</pose>
      <topic>/aeb360/lidar</topic>
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <!-- About 0.5 degree angular spacing over 360 degrees. -->
            <samples>721</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>

    <sensor name="front_rgb_camera" type="camera">
      <!-- Front RGB camera. Camera looks along the vehicle +X axis. -->
      <pose>0.9 0 0.75 0 0 0</pose>
      <topic>/aeb360/camera/image</topic>
      <update_rate>15</update_rate>

      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.10</near>
          <far>100.0</far>
        </clip>
      </camera>

      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>

    </link>


    <!-- ================================================== -->
    <!-- REAR LEFT WHEEL                                    -->
    <!-- ================================================== -->

    <link name="rear_left_wheel">

      <pose>
        -1.0 0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>3.0</mass>

        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.15</izz>
        </inertia>

      </inertial>


      <collision name="collision">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="visual">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================================================== -->
    <!-- REAR RIGHT WHEEL                                   -->
    <!-- ================================================== -->

    <link name="rear_right_wheel">

      <pose>
        -1.0 -0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>3.0</mass>

        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.15</izz>
        </inertia>

      </inertial>


      <collision name="collision">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="visual">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================================================== -->
    <!-- FRONT STEERING LINKS                               -->
    <!-- ================================================== -->

    <link name="front_left_steering">

      <pose>
        1.0 0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>0.5</mass>

        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>

      </inertial>

    </link>


    <link name="front_right_steering">

      <pose>
        1.0 -0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>0.5</mass>

        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>

      </inertial>

    </link>


    <!-- ================================================== -->
    <!-- FRONT LEFT WHEEL                                   -->
    <!-- ================================================== -->

    <link name="front_left_wheel">

      <pose>
        1.0 0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>3.0</mass>

        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.15</izz>
        </inertia>

      </inertial>


      <collision name="collision">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="visual">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================================================== -->
    <!-- FRONT RIGHT WHEEL                                  -->
    <!-- ================================================== -->

    <link name="front_right_wheel">

      <pose>
        1.0 -0.72 0.30 0 0 0
      </pose>

      <inertial>

        <mass>3.0</mass>

        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.15</izz>
        </inertia>

      </inertial>


      <collision name="collision">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>

      </collision>


      <visual name="visual">

        <pose>
          0 0 0 1.570796 0 0
        </pose>

        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

    </link>


    <!-- ================================================== -->
    <!-- REAR DRIVE JOINTS                                  -->
    <!-- ================================================== -->

    <joint
      name="rear_left_wheel_joint"
      type="revolute">

      <parent>chassis</parent>
      <child>rear_left_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <joint
      name="rear_right_wheel_joint"
      type="revolute">

      <parent>chassis</parent>
      <child>rear_right_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <!-- ================================================== -->
    <!-- FRONT STEERING JOINTS                              -->
    <!-- ================================================== -->

    <joint
      name="front_left_steering_joint"
      type="revolute">

      <parent>chassis</parent>
      <child>front_left_steering</child>

      <axis>

        <xyz>0 0 1</xyz>

        <limit>
          <lower>-0.55</lower>
          <upper>0.55</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <joint
      name="front_right_steering_joint"
      type="revolute">

      <parent>chassis</parent>
      <child>front_right_steering</child>

      <axis>

        <xyz>0 0 1</xyz>

        <limit>
          <lower>-0.55</lower>
          <upper>0.55</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <!-- ================================================== -->
    <!-- FRONT WHEEL JOINTS                                 -->
    <!-- ================================================== -->

    <joint
      name="front_left_wheel_joint"
      type="revolute">

      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <joint
      name="front_right_wheel_joint"
      type="revolute">

      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1000000</effort>
        </limit>

      </axis>

    </joint>


    <!-- ================================================== -->
    <!-- ACKERMANN STEERING                                 -->
    <!-- ================================================== -->

    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">

      <left_joint>
        rear_left_wheel_joint
      </left_joint>

      <right_joint>
        rear_right_wheel_joint
      </right_joint>

      <left_steering_joint>
        front_left_steering_joint
      </left_steering_joint>

      <right_steering_joint>
        front_right_steering_joint
      </right_steering_joint>

      <wheel_base>
        2.0
      </wheel_base>

      <wheel_separation>
        1.44
      </wheel_separation>

      <kingpin_width>
        1.44
      </kingpin_width>

      <wheel_radius>
        0.30
      </wheel_radius>

      <steering_limit>
        0.50
      </steering_limit>

      <min_velocity>
        -5.0
      </min_velocity>

      <max_velocity>
        10.0
      </max_velocity>

      <min_acceleration>
        -4.0
      </min_acceleration>

      <max_acceleration>
        3.0
      </max_acceleration>

      <topic>
        /model/aeb_vehicle_360/cmd_vel
      </topic>

      <odom_topic>
        /model/aeb_vehicle_360/odometry
      </odom_topic>

      <odom_publish_frequency>
        20
      </odom_publish_frequency>

    </plugin>

  </model>

</sdf>
