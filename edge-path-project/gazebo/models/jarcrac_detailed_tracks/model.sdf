        <topic>/jarcrac/lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>721</samples>
              <resolution>1</resolution>
              <min_angle>-1.570796327</min_angle>
              <max_angle>1.570796327</max_angle>
