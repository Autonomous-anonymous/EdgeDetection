    <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
      <left_track>
        <link>track_left</link>
      </left_track>
      <right_track>
        <link>track_right</link>
      </right_track>
      <tracks_separation>1.27</tracks_separation>
      <track_height>0.811134</track_height>
      <steering_efficiency>0.5</steering_efficiency>
      <linear_velocity>
        <min_velocity>-0.3</min_velocity>
        <max_velocity>0.3</max_velocity>
        <min_acceleration>-2</min_acceleration>
        <max_acceleration>1</max_acceleration>
      </linear_velocity>
      <angular_velocity>
        <min_velocity>-0.25</min_velocity>
        <max_velocity>0.25</max_velocity>
      </angular_velocity>
      <topic>/model/jarcrac/detailed_cmd_vel</topic>
      <odom_topic>/model/jarcrac/detailed_odometry</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
