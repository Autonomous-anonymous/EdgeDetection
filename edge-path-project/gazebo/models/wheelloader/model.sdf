    <link name="lift_arm">
      <pose>2.225 0 2.134 0 0.353982 0</pose>
      <inertial>
        <pose>1.470232 0 0.171488 0 0 0</pose>
        <mass>1000</mass>
        <inertia>
          <ixx>300.19721</ixx><iyy>435.403484</iyy><izz>446.506274</izz>
          <ixy>0</ixy><ixz>6.606637</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="lift_arm_graphics">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/lift_arm.obj</uri></mesh></geometry>
      </visual>
      <collision name="coll_lift_arm_graphics">
        <geometry><mesh><uri>model://wheelloader/meshes/collision/coll_lift_arm.stl</uri></mesh></geometry>
      </collision>
      <collision name="coll_lift_arm_full_graphics">
        <geometry><mesh><uri>model://wheelloader/meshes/collision/coll_lift_arm_full.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="bucket_clamp">
      <pose>4.859841 0 1.1603 0 -0.361603 0</pose>
      <inertial>
        <pose>0.008401 0 0.301732 0 0 0</pose>
        <mass>465</mass>
        <inertia>
          <ixx>88.429396</ixx><iyy>58.042396</iyy><izz>100.229997</izz>
          <ixy>0</ixy><ixz>4.53054</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="bucket_clamp_graphics">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/bucket_clamp.obj</uri></mesh></geometry>
      </visual>
      <collision name="coll_bucket_clamp_graphics">
        <geometry><mesh><uri>model://wheelloader/meshes/collision/coll_bucket_clamp.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="bucket">
      <pose>5.070717 0 1.213332 0 -0.361603 0</pose>
      <inertial>
        <pose>0.54 0 0.334 0 0 0</pose>
        <mass>1105</mass>
        <inertia>
          <ixx>1100</ixx><iyy>850</iyy><izz>1350</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="bucket_graphics">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/bucket.obj</uri></mesh></geometry>
      </visual>
      <collision name="coll_bucket_graphics">
        <geometry><mesh><uri>model://wheelloader/meshes/collision/coll_bucket.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="wheel_rl">
      <pose>0.01 0.856 0.745 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>4.346807</ixx><iyy>7.971615</iyy><izz>4.346807</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_l_graphics">
        <pose>0 0 0 0 0 3.141593</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/tyre.obj</uri></mesh></geometry>
      </visual>
      <collision name="wheel_rl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.729</radius><length>0.38</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>0.8</mu><mu2>0.6</mu2><fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_rr">
      <pose>0.01 -0.856 0.745 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>4.346807</ixx><iyy>7.971615</iyy><izz>4.346807</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_r_graphics">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/tyre.obj</uri></mesh></geometry>
      </visual>
      <collision name="wheel_rr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.729</radius><length>0.38</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>0.8</mu><mu2>0.6</mu2><fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_fl">
      <pose>2.915 0.856 0.732 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>4.346807</ixx><iyy>7.971615</iyy><izz>4.346807</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_l_graphics">
        <pose>0 0 0 0 0 3.141593</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/tyre.obj</uri></mesh></geometry>
      </visual>
      <collision name="wheel_fl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.729</radius><length>0.38</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>0.8</mu><mu2>0.6</mu2><fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_fr">
      <pose>2.915 -0.856 0.732 0 0 0</pose>
      <inertial>
        <mass>30</mass>
        <inertia>
          <ixx>4.346807</ixx><iyy>7.971615</iyy><izz>4.346807</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="wheel_r_graphics">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/tyre.obj</uri></mesh></geometry>
      </visual>
      <collision name="wheel_fr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>0.729</radius><length>0.38</length></cylinder></geometry>
        <surface><friction><ode>
          <mu>0.8</mu><mu2>0.6</mu2><fdir1>1 0 0</fdir1>
        </ode></friction></surface>
      </collision>
    </link>

    <!-- Oscillating rear axle: Mevea spring K and damper C, end stops at +-12 deg -->
    <joint name="axle_oscillation_joint" type="revolute">
      <parent>rear_frame</parent>
      <child>rear_axle</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">1 0 0</xyz>
        <limit><lower>-0.20944</lower><upper>0.20944</upper><effort>10000000</effort></limit>
        <dynamics><damping>80000</damping><spring_stiffness>10000</spring_stiffness><spring_reference>0</spring_reference></dynamics>
      </axis>
    </joint>

    <!-- Articulation pivot (vertical); range from the steering cylinder stroke; positive = front frame turns left -->
    <joint name="articulation_joint" type="revolute">
      <parent>rear_frame</parent>
      <child>front_frame</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-0.3315</lower><upper>0.3315</upper><effort>10000000</effort></limit>
      </axis>
    </joint>

    <!-- Lift arm; range from the lift cylinder stroke; angle 0 = Mevea initial pose, positive = raise -->
    <joint name="lift_joint" type="revolute">
      <parent>front_frame</parent>
      <child>lift_arm</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 -1 0</xyz>
        <limit><lower>-0.4345</lower><upper>1.1045</upper><effort>10000000</effort></limit>
      </axis>
    </joint>

    <!-- Bucket pivot, driven directly (Z-bar loop not simulated); Mevea damper range; positive = rack back -->
    <joint name="bucket_tilt_joint" type="revolute">
      <parent>lift_arm</parent>
      <child>bucket_clamp</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 -1 0</xyz>
        <limit><lower>-2.199115</lower><upper>0.64764</upper><effort>10000000</effort></limit>
      </axis>
    </joint>

    <joint name="bucket_fixed_joint" type="fixed">
      <parent>bucket_clamp</parent>
      <child>bucket</child>
    </joint>

    <joint name="wheel_rl_joint" type="revolute">
      <parent>rear_axle</parent>
      <child>wheel_rl</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><effort>30000</effort></limit>
      </axis>
    </joint>

    <joint name="wheel_rr_joint" type="revolute">
      <parent>rear_axle</parent>
      <child>wheel_rr</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><effort>30000</effort></limit>
      </axis>
    </joint>

    <joint name="wheel_fl_joint" type="revolute">
      <parent>front_frame</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><effort>30000</effort></limit>
      </axis>
    </joint>

    <joint name="wheel_fr_joint" type="revolute">
      <parent>front_frame</parent>
      <child>wheel_fr</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><effort>30000</effort></limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rl_joint</joint_name>
      <topic>/wheelloader/wheel_rl/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_rr_joint</joint_name>
      <topic>/wheelloader/wheel_rr/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_fl_joint</joint_name>
      <topic>/wheelloader/wheel_fl/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_fr_joint</joint_name>
      <topic>/wheelloader/wheel_fr/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>articulation_joint</joint_name>
      <topic>/wheelloader/articulation/cmd_pos</topic>
      <p_gain>5000000</p_gain><i_gain>0</i_gain><d_gain>2000000</d_gain>
      <cmd_max>1.0e7</cmd_max><cmd_min>-1.0e7</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_joint</joint_name>
      <topic>/wheelloader/lift/cmd_pos</topic>
      <p_gain>2000000</p_gain><i_gain>0</i_gain><d_gain>800000</d_gain>
      <cmd_max>1.0e7</cmd_max><cmd_min>-1.0e7</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>bucket_tilt_joint</joint_name>
      <topic>/wheelloader/bucket_tilt/cmd_pos</topic>
      <p_gain>1000000</p_gain><i_gain>0</i_gain><d_gain>100000</d_gain>
      <cmd_max>1.0e7</cmd_max><cmd_min>-1.0e7</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
