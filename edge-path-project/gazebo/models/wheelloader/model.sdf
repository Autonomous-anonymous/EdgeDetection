<?xml version="1.0"?>
<!--
  GENERATED by scripts/generate_wheelloader_model.py - do not edit by hand.
  Source of truth: the Mevea WheelLoader model (see wheelloader_params.json).
  Frame: Gazebo Z-up, x forward, y left.  Model origin = Mevea world origin (rear axle
  centre line, ground level), raised 0.007 m so the lowest tyre rests on z = 0.
-->
<sdf version="1.10">
  <model name="wheelloader">
    <self_collide>false</self_collide>

    <link name="rear_frame">
      <pose>1.46 0 0.981 0 0 0</pose>
      <inertial>
        <pose>-1.64 0 0.256 0 0 0</pose>
        <mass>5777.8923</mass>
        <inertia>
          <ixx>3263.9524</ixx><iyy>6018.5391</iyy><izz>7184.591</izz>
          <ixy>108.34807</ixy><ixz>78.009391</ixz><iyz>170.81525</iyz>
        </inertia>
      </inertial>
      <visual name="rear_frame_graphics">
        <pose>0 0 -0.32 0 0 0</pose>
        <geometry><mesh><uri>model://wheelloader/meshes/rear_frame.obj</uri></mesh></geometry>
      </visual>
      <visual name="cabin_outside_graphics">
        <pose>0 0 -0.32 0 0 0</pose>
