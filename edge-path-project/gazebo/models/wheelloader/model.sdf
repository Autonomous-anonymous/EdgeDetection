      </collision>
      <sensor name="camera_seat" type="camera">
        <pose>-0.4 0 2 0 0.124355 0</pose>
        <topic>/wheelloader/camera_seat/image</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>150.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
      <sensor name="camera_rear" type="camera">
        <pose>-0.655 0 2.01 0 0.219456 3.141593</pose>
        <topic>/wheelloader/camera_rear/image</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>150.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <link name="rear_axle">
      <pose>0 0 0.737 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>218.4</mass>
        <inertia>
