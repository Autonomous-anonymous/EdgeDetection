<?xml version="1.0"?>
<!--
  GENERATED by scripts/generate_jarcrac_model.py - do not edit by hand.
  Source of truth: the Mevea JARCRAC model XML (see jarcrac_params.json).
  Frame: Gazebo Z-up, x forward, y left.  Model origin = Mevea body origin,
  raised 0.711 m so the lowest road wheel rests on z = 0.
-->
<sdf version="1.10">
  <model name="jarcrac">
    <self_collide>false</self_collide>

    <link name="chassis">
      <pose>0 0 0.711 0 0 0</pose>
      <inertial>
        <pose>-0.187562 0 0.061197 0 0 0</pose>
        <mass>2192.236412</mass>
        <inertia>
          <ixx>744.247693</ixx><iyy>1594.691833</iyy><izz>1458.973194</izz>
          <ixy>0</ixy><ixz>7.69924</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Runko_part.STL; placement derived by chamfer alignment to the Mevea-placed Jarcrac_body.STL (median nearest-vertex distance 1.5 mm); not stated in any Mevea file -->
      <visual name="body_visual">
        <pose>-1.53 0.804 -0.588 1.570796 0 0</pose>
        <geometry><mesh>
          <uri>model://jarcrac/meshes/Runko_part.STL</uri>
          <scale>1 1 1</scale>
        </mesh></geometry>
        <material><diffuse>0.85 0.15 0.10 1</diffuse><ambient>0.85 0.15 0.10 1</ambient></material>
      </visual>

      <!-- Simplified collision: bounding box of the body mesh (a mesh collision would be
           expensive and the Mevea body only touches the ground through its tracks). -->
      <collision name="body_collision">
        <pose>-0.04 0.02 0.439966 0 0 0</pose>
        <geometry><box><size>2.98 1.568 2.055933</size></box></geometry>
      </collision>

      <sensor name="gpu_lidar_front" type="gpu_lidar">
        <pose>1.68 0 -0.111 0 0 0</pose>
        <topic>/jarcrac/lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>721</samples><resolution>1</resolution>
              <min_angle>-1.570796327</min_angle><max_angle>1.570796327</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples><resolution>1</resolution>
              <min_angle>-0.261799388</min_angle>
              <max_angle>0.261799388</max_angle>
            </vertical>
          </scan>
          <range><min>0.3</min><max>30</max><resolution>0.01</resolution></range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.015</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <sensor name="front_rgb_camera" type="camera">
        <!-- Mevea Camera_cabin (default from Jarcrac_rev7.xml) pose and field of view -->
        <pose>1.3 0 1 0 0 0</pose>
        <topic>/jarcrac/camera/image</topic>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>0.785398</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>100.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

