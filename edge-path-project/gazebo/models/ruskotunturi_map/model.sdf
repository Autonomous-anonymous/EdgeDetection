<?xml version="1.0"?>
<sdf version="1.10">
  <model name="ruskotunturi_map">
    <static>true</static>

    <link name="terrain_link">

      <!--
        The OBJ asset is exported with a different up-axis.
        Rotating +90 degrees around X aligns it with the collision STL.
      -->
      <visual name="terrain_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>

        <geometry>
          <mesh>
            <uri>model://ruskotunturi_map/meshes/ruskotunturi-map.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://ruskotunturi_map/meshes/ruskotunturi-map-collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
