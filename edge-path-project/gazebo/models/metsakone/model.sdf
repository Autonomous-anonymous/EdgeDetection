<?xml version="1.0" ?>
<sdf version="1.10">
    <model name="metsakone">
        <!-- World includes determine the spawn pose. -->
        <allow_auto_disable>false</allow_auto_disable>
        <link name="front_chassis">
            <pose>-0.151427 0 0.175 0 0 0</pose>
            <inertial>
                <mass>55.14395</mass>
                <inertia>
                <ixx>0.126164</ixx><ixy>0</ixy><ixz>0</ixz>
                <iyy>0.416519</iyy><iyz>0</iyz><izz>0.481014</izz>
                </inertia>
            </inertial>


            <visual name="visual">
                <pose>-1.0 -0.8 -0.4 1.5708 0 0</pose>
                <geometry>
                    <!-- <box><size>3.0 1.4 0.85</size></box> -->
                <mesh>
                    <uri>model://metsakone/meshes/telalaite.obj</uri>
                    <scale>1.0 1.0 1.0</scale>
                </mesh>
                </geometry>
                <material>
                <diffuse>1.0 1.0 1.0 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            <collision name="front_collision">
                <geometry>
                    <!-- <box><size>3.0 1.5 1.0</size></box> -->
                    <mesh>
                        <uri>model://metsakone/meshes/telalaite.stl</uri>
                        <scale>1.0 1.0 1.0</scale>
                    </mesh>
                </geometry>
            </collision>




            <!-- Forward 180-degree LiDAR for AEB; 361 rays, 10 Hz, 30 m. -->
            <sensor name="gpu_lidar" type="gpu_lidar">
                <pose>2.0 0 0.5 0 0 0</pose>
                <topic>/model/metsakone/lidar</topic>
                <update_rate>10</update_rate>
                <ray>
                <scan>
                    <horizontal>
                    <samples>361</samples>
                    <resolution>1</resolution>
                    <min_angle>-1.58</min_angle> <!-- 90°-->
                    <max_angle>1.58</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>30.0</max>
                    <resolution>0.01</resolution>
                </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor>

            <!-- Lisää tämä front_chassis <link>-elementin sisälle: -->
            <sensor name="front_bumper_sensor" type="contact">
                <topic>/model/metsakone/contacts/front</topic>
                <contact>
                    <!-- Tämän täytyy täsmätä front_chassis-linkin collision-nimeen! -->
                    <collision>front_collision</collision>
                </contact>
                <always_on>true</always_on>
                <update_rate>30</update_rate>
            </sensor>

        </link>
        <link name="rear_chassis">
            <self_collide>false</self_collide>
            <pose>-2.051427 0 0.175 0 0 3.14</pose>
            <inertial>
                <mass>55.14395</mass>
                <inertia>
                <ixx>0.126164</ixx><ixy>0</ixy><ixz>0</ixz>
                <iyy>0.416519</iyy><iyz>0</iyz><izz>0.481014</izz>
                </inertia>
            </inertial>


            <visual name="visual">
                <pose>-1.0 -0.8 -0.4 1.5708 0 1.57079</pose>
                <geometry>
                <mesh>
                    <uri>model://metsakone/meshes/rear_chassis.obj</uri>
                    <scale>1.0 1.0 1.0</scale>
                </mesh>
                </geometry>
                <material>
                <diffuse>1.0 1.0 1.0 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <mesh>
              <uri>model://metsakone/meshes/rear_chassis_collision.stl</uri>
              <scale>1.0 1.0 1.0</scale>
                    </mesh>
                </geometry>
            </collision>
        </link>
        <frame name="deck_mount_point" attached_to="rear_chassis">
            <pose relative_to="rear_chassis">1.2 0 0.6 0 0 0</pose>
        </frame>

        
        <link name="loader_mount">
            <pose relative_to="deck_mount_point">0 0 0 0 0 0</pose>
            <inertial>
            <mass>0.5</mass>
            <inertia>
                <ixx>0.01</ixx> <iyy>0.01</iyy> <izz>0.01</izz>
                <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
            </inertia>
            </inertial>
        </link>
        <link name="loader_arm">
            <self_collide>false</self_collide>
            <pose relative_to="deck_mount_point">1.0 0 0 0 0 0</pose>
            <inertial>
                <mass>10.0</mass>
                <inertia>
                <ixx>0.5</ixx> <iyy>1.0</iyy> <izz>1.0</izz>
                <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
                </inertia>
            </inertial>

            <collision name="loader_collision">
                <pose>0 0 0.4 0 0 0</pose>
                <geometry>
                <box><size>2.0 0.25 0.25</size></box>
                </geometry>
            </collision>

            <visual name="loader_visual">
                <pose>0 0 0.4 0 0 0</pose>
                <geometry>
                <box><size>2.0 0.25 0.25</size></box>
                </geometry>
                <material>
                <ambient>0.9 0.7 0.0 1</ambient>
                <diffuse>0.9 0.7 0.0 1</diffuse>
                </material>
            </visual>
        </link>

        <link name="bucket">
            <pose relative_to="loader_arm">0.5 0 0.2 0 0 0</pose>
            <inertial>
                <mass>10</mass>
                <inertia>
                <ixx>0.2</ixx> <iyy>0.4</iyy> <izz>0.4</izz>
                <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
                </inertia>
            </inertial>


            <collision name="bucket_collision">
                <pose>0.5 0 0.2 0 0 0</pose>
                <geometry>
                <box><size>0.4 1.3 0.35</size></box>
                </geometry>
            </collision>

  
            <visual name="bucket_visual">
                <pose>0.5 0 0.2 0 0 0</pose>
                <geometry>
                <box><size>0.4 1.3 0.35</size></box>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                </material>
            </visual>
            <visual name="bucket_top_visual">
                <pose relative_to="bucket">0.5 0 0.38 0 1.5708 0</pose>
                <geometry>
                    <box><size>0.01 1.3 0.35</size></box>
                </geometry>
                <material>
                    <ambient>1.0 0.3 0.0 1</ambient>
                    <diffuse>1.0 0.3 0.0 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
                </material>
            </visual>
        </link>

        <link name="front_left_wheel">
        <pose>0.554283 0.725029 -0.025 -1.5707 0 0</pose>
        <inertial>
            <mass>2</mass>
            <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
            </inertia>
        </inertial>
        <visual name="visual">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="wheel_marker">
            <pose>0.1 0.5 0.3 0 0 0</pose>
            <geometry>
                    <box><size>0.01 0.3 0.35</size></box>
            </geometry>
            <material>
                    <ambient>1.0 0.3 0.0 1</ambient>
                    <diffuse>1.0 0.3 0.0 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <collision name="collision">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
        </collision>
        </link>

        <link name="front_right_wheel">
        <pose>0.554282 -0.725029 -0.025 -1.5707 0 0</pose>
        <inertial>
            <mass>2</mass>
            <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
            </inertia>
        </inertial>
        <visual name="visual">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="wheel_marker">
            <pose>0.1 0.5 -0.3 0 0 0</pose>
            <geometry>
                    <box><size>0.01 0.3 0.35</size></box>
            </geometry>
            <material>
                    <ambient>1.0 0.3 0.0 1</ambient>
                    <diffuse>1.0 0.3 0.0 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <collision name="collision">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
        </collision>
        </link>

        <link name="rear_right_wheel">
        <pose>-2.957138 -0.725029 -0.025 -1.5707 0 0</pose>
        <inertial>
            <mass>2</mass>
            <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
            </inertia>
        </inertial>
        <visual name="visual">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="wheel_marker">
            <pose>0.1 0.5 -0.3 0 0 0</pose>
            <geometry>
                    <box><size>0.01 0.3 0.35</size></box>
            </geometry>
            <material>
                    <ambient>1.0 0.3 0.0 1</ambient>
                    <diffuse>1.0 0.3 0.0 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <collision name="collision">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
        </collision>
        </link>

        <link name="rear_left_wheel">
        <pose>-2.957138 0.725029 -0.025 -1.5707 0 0</pose>
        <inertial>
            <mass>2</mass>
            <inertia>
            <ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz>
            </inertia>
        </inertial>
        <visual name="visual">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="wheel_marker">
            <pose>0.1 0.5 0.3 0 0 0</pose>
            <geometry>
                    <box><size>0.01 0.3 0.35</size></box>
            </geometry>
            <material>
                    <ambient>1.0 0.3 0.0 1</ambient>
                    <diffuse>1.0 0.3 0.0 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
            </material>
        </visual>
        <collision name="collision">
            <geometry><cylinder><radius>0.6</radius><length>0.4</length></cylinder></geometry>
        </collision>
        </link>

        <joint name="articulation_joint" type="revolute">
            <pose relative_to="front_chassis">-0.6 0 0 0 0 0</pose>
            <parent>front_chassis</parent>
            <child>rear_chassis</child>
            <axis>
            <!-- Z-akseli = pystysuora sarana, jonka ympäri rungot taipuvat sivusuunnassa -->
            <xyz>0 0 1</xyz>
            <limit>
                <lower>-0.78</lower> <!-- Noin -45 astetta -->
                <upper>0.78</upper>  <!-- Noin +45 astetta -->
                <effort>5000</effort> <!-- Vääntömomentti, jolla runko vääntyy -->
                <velocity>1.0</velocity>
            </limit>
            <dynamics>
                <damping>50.0</damping>
            </dynamics>
            </axis>
        </joint>

        <joint name="front_left_wheel_joint" type="revolute">
        <parent>front_chassis</parent><child>front_left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
        </joint>
        <joint name="front_right_wheel_joint" type="revolute">
        <parent>front_chassis</parent><child>front_right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
        </joint>
        <joint name="rear_left_wheel_joint" type="revolute">
        <parent>rear_chassis</parent><child>rear_left_wheel</child>
        <axis><xyz>0 0 1</xyz>
            <limit>
                <effort>500</effort>
                <velocity>8.0</velocity>
            </limit>
        </axis>
        </joint>
        <joint name="rear_right_wheel_joint" type="revolute">
        <parent>rear_chassis</parent><child>rear_right_wheel</child>
        <axis><xyz>0 0 1</xyz>
            <limit>
                <effort>500</effort>
                <velocity>8.0</velocity>
            </limit>
        </axis>
        </joint>

        <joint name="loader_mount_fixed_joint" type="fixed">
            <parent>rear_chassis</parent>
            <child>loader_mount</child>
        </joint>

        <joint name="loader_joint" type="revolute">
            <parent>loader_mount</parent>
            <child>loader_arm</child>

            <pose>-1.0 0 0 0 0 0</pose>
            <axis>

                <xyz>0 1 0</xyz>
                <limit>
                <lower>-1.2</lower>
                <upper>0.2</upper> 
                <effort>2000</effort> 
                <velocity>1.0</velocity>
                </limit>
                <dynamics>
                <damping>20.0</damping>
                </dynamics>
            </axis>
        </joint>

        <joint name="bucket_joint" type="revolute">
            <parent>loader_arm</parent>
            <child>bucket</child>
            <pose>0.5 0 0.2 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                <lower>-0.9</lower> 
                <upper>1.0</upper> 
                <effort>1000</effort>
                <velocity>1.5</velocity>
                </limit>
                <dynamics>
                <damping>10.0</damping>
                </dynamics>
            </axis>
        </joint>

        <!-- Single four-wheel propulsion plugin; keep independent articulation
             position control. Differential-drive yaw commands remain zero in
             this first straight-line AEB experiment. -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>rear_left_wheel_joint</left_joint>
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>1.25</wheel_separation>
            <wheel_radius>0.6</wheel_radius>
            <topic>/model/metsakone/cmd_vel</topic>
            <odom_topic>/model/metsakone/odometry</odom_topic>
            <odom_publish_frequency>20</odom_publish_frequency>
            <max_linear_velocity>1.0</max_linear_velocity>
            <min_linear_velocity>-1.0</min_linear_velocity>
            <max_linear_acceleration>1.0</max_linear_acceleration>
            <min_linear_acceleration>-2.5</min_linear_acceleration>
        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>articulation_joint</joint_name>
            <topic>/model/metsakone/steering_cmd</topic>
            <p_gain>10000</p_gain>
            <i_gain>100</i_gain>
            <d_gain>1000</d_gain>
            <cmd_max>5000</cmd_max>
            <cmd_min>-5000</cmd_min>
        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>loader_joint</joint_name>
            <topic>/model/metsakone/loader_cmd</topic>
            <!-- PID-arvot määrittävät kuinka jäykästi puomi hakeutuu tavoitekulmaan -->
            <p_gain>1500</p_gain>
            <i_gain>50</i_gain>
            <d_gain>150</d_gain>
            <i_max>500</i_max>
            <i_min>-500</i_min>
            <cmd_max>2000</cmd_max>
            <cmd_min>-2000</cmd_min>
        </plugin>

        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>bucket_joint</joint_name>
            <topic>/model/metsakone/bucket_cmd</topic>
            <use_velocity_commands>true</use_velocity_commands>
            <cmd_max>1.5</cmd_max>
            <cmd_min>-1.5</cmd_min>
        </plugin>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>loader_joint</joint_name>
            <joint_name>bucket_joint</joint_name>
            <topic>/model/metsakone/joint_states</topic>
        </plugin>
        <plugin
            filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <publish_link_pose>false</publish_link_pose>
            <update_frequency>30</update_frequency>
        </plugin>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    </model>
</sdf>